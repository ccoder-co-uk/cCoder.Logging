{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "StoreLogEntries": false,
    "StreamLogEntries": false,
    "RetentionDays": 30,
    "RetentionIntervalMinutes": 60,
    "DefaultAppId": 1,
    "DefaultAppDomain": "localhost",
    "RootPath": "Api/Logging",
    "RequestLoggingEnabled": true,
    "RequestLoggingQueueCapacity": 1024,
    "RequestLoggingQueueFullBehavior": "DropNewest",
    "DatabaseMinimumLogLevel": "Warning"
  },
  "CoreData": {
    "ConnectionString": "",
    "AdminConnectionString": "",
    "DebugInfo": false,
    "LogSQL": false
  },
  "Eventing": {
    "ProviderType": "Http",
    "Http": {
      "HubUrl": "",
      "MaxConcurrency": 1
    },
    "ServiceBus": {
      "ConnectionString": "",
      "MaxConcurrency": 1
    }
  }
}
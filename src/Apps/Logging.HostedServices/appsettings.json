{
  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "ConnectionStrings": {
    "Core": ""
  },

  "LoggingConfiguration": {
    "StoreLogEntries": false,
    "StreamLogEntries": false,
    "RetentionDays": 30,
    "RetentionIntervalMinutes": 60,
    "DefaultAppId": 1,
    "DefaultAppDomain": "localhost"
  },

  "Settings": {
    "CacheSourceAppId": 1
  },

  "Services": {
  }
}

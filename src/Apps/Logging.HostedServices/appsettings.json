{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "ConnectionString": "",
    "StoreLogEntries": false,
    "StreamLogEntries": false,
    "RetentionDays": 30,
    "RetentionIntervalMinutes": 60,
    "DefaultAppId": 1,
    "DefaultAppDomain": "localhost",
    "RootPath": "Api/Logging"
  },
  "Eventing": {
    "ProviderType": "Http",
    "Http": {
      "HubUrl": "",
      "MaxConcurrency": 1
    },
    "ServiceBus": {
      "ConnectionString": "",
      "MaxConcurrency": 1
    }
  }
}
